table dim_class

	column fault_class
		dataType: string
		sourceColumn: fault_class

	column label
		dataType: string
		sourceColumn: label

	column color
		dataType: string
		sourceColumn: color

	partition dim_class = m
		mode: import
		source =
			let
				Source = #table(
					type table [fault_class = text, label = text, color = text],
					{
					{ "index-off-by-one", "Index off-by-one", "#008300" },
					{ "boundary-comparator", "Boundary comparator", "#e87ba4" },
					{ "dropped-term", "Dropped height term", "#eda100" },
					{ "exec-order-linkage", "Execution order / linkage", "#2a78d6" },
					{ "split-rank-boundary", "Split / merge rank", "#1baf7a" }
					}
				)
			in
				Source
