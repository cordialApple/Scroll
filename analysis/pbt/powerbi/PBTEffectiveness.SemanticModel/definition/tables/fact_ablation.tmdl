table fact_ablation

	measure 'Ablation Detection' = AVERAGE(fact_ablation[detection_rate])
		formatString: 0%

	column config_key
		dataType: string
		sourceColumn: config_key

	column config_label
		dataType: string
		sourceColumn: config_label

	column fault_class
		dataType: string
		sourceColumn: fault_class

	column fault_class_label
		dataType: string
		sourceColumn: fault_class_label

	column budget
		dataType: int64
		summarizeBy: none
		sourceColumn: budget

	column detection_rate
		dataType: double
		summarizeBy: none
		sourceColumn: detection_rate

	partition fact_ablation = m
		mode: import
		source =
			let
				Source = #table(
					type table [config_key = text, config_label = text, fault_class = text, fault_class_label = text, budget = Int64.Type, detection_rate = number],
