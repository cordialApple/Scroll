					{ "full", "Full (strong gen + strong oracle)", "split-rank-boundary", "Split / merge rank", 100, 1.0 },
					{ "full", "Full (strong gen + strong oracle)", "split-rank-boundary", "Split / merge rank", 1000, 1.0 },
