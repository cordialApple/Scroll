table fact_detection

	measure 'Mutant Detection' = AVERAGE(fact_detection[detection_rate])
		formatString: 0%

	measure 'Mutants Caught' = DISTINCTCOUNT(fact_detection[mutant_id])
		formatString: 0

	column mutant_id
		dataType: string
		sourceColumn: mutant_id

	column fault_class
		dataType: string
		sourceColumn: fault_class

	column budget
		dataType: int64
		summarizeBy: none
		sourceColumn: budget

	column detection_rate
		dataType: double
		summarizeBy: none
		sourceColumn: detection_rate

	partition fact_detection = m
		mode: import
		source =
			let
				Source = #table(
					type table [mutant_id = text, fault_class = text, budget = Int64.Type, detection_rate = number],
