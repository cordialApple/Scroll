table dim_budget

	column budget
		dataType: int64
		summarizeBy: none
		sourceColumn: budget

	column log10
		dataType: double
		summarizeBy: none
		sourceColumn: log10

	column order_of_magnitude
		dataType: int64
		summarizeBy: none
		sourceColumn: order_of_magnitude

	partition dim_budget = m
		mode: import
		source =
			let
				Source = #table(
					type table [budget = Int64.Type, log10 = number, order_of_magnitude = Int64.Type],
					{
					{ 1, 0.0, 0 },
					{ 3, 0.4771, 0 },
					{ 10, 1.0, 1 },
					{ 30, 1.4771, 1 },
					{ 100, 2.0, 2 },
					{ 300, 2.4771, 2 },
					{ 1000, 3.0, 3 },
					{ 3000, 3.4771, 3 }
					}
				)
			in
				Source
