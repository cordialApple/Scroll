{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "v_line",
  "position": {
    "x": 16,
    "y": 88,
    "z": 0,
    "width": 760,
    "height": 400,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_budget"
                    }
                  },
                  "Property": "budget"
                }
              },
              "queryRef": "dim_budget.budget"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_class_detection"
                    }
                  },
                  "Property": "Detection Rate"
                }
              },
              "queryRef": "fact_class_detection.Detection Rate"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_class"
                    }
                  },
                  "Property": "label"
                }
              },
              "queryRef": "dim_class.label"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [],
        "isDefaultSort": true
      }
    },
    "objects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Injected-fault sensitivity vs. case budget'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}