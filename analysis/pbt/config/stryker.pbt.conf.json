{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Measures PBT-only mutation kill rate: runs *.pbt.test.ts (provider-chaos excluded) against the 8 modules the PBT suite claims to protect. Kill rate = how many injected logic/order-of-execution bugs the property tests catch.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.pbt.config.ts" },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 60000,
  "mutate": [
    "src/doc/anchor.ts",
    "src/doc/model.ts",
    "src/layout/orderIndex.ts",
    "src/layout/layout.ts",
    "src/editor/docModel.ts",
    "src/agent/spatialGuard.ts",
    "src/agent/guardTracker.ts",
    "src/agent/observer.ts"
  ],
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": { "fileName": "test-results/stryker-pbt/mutation.html" },
  "jsonReporter": { "fileName": "test-results/stryker-pbt/mutation.json" },
  "thresholds": { "high": 80, "low": 60, "break": null }
}
